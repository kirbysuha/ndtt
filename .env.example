# VPS Kurulumu için Örnek Çevre Değişkenleri (.env olarak kaydedin)
# Sunucu IP adresiniz veya alan adınız ile değiştirin (örn: 195.142.xx.xx veya ndtt.domain.com)

# Backend'in izin vereceği frontend adresleri (JSON array formatında):
ALLOWED_ORIGINS=["http://localhost:3000","http://SUNUCU_IP_VEYA_DOMAIN:3000","http://SUNUCU_IP_VEYA_DOMAIN"]

# Frontend Next.js build edilirken kullanılan backend URL'si:
NEXT_PUBLIC_API_URL=http://SUNUCU_IP_VEYA_DOMAIN:8000

# Veritabanı şifresi (İsteğe bağlı güçlü bir şifre belirleyin):
POSTGRES_USER=ndtt_user
POSTGRES_PASSWORD=ndtt_pass
POSTGRES_DB=ndtt_db

# Gizli anahtar
SECRET_KEY=change-this-to-a-very-secure-random-string-in-production
